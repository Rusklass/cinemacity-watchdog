# ===================================================================
# Cinema City Watchdog - Environment Variables & Secrets Template
# ===================================================================
#
# For local use:
# Copy this file or set these variables in PowerShell / Bash.
#
# For GitHub Actions:
# Add these in GitHub:
# Repository -> Settings -> Secrets and variables -> Actions
# ===================================================================

# -------------------------------------------------------------------
# 1. FILM & SCREENING FILTERS
# -------------------------------------------------------------------
# Film title substring (case-insensitive).
# "dun" matches both Czech "Duna: část třetí" and English "Dune"
FILM_PATTERN=dun

# Auditorium name substring ("imax" for IMAX Flora, or "" for all auditoriums)
AUDITORIUM_PATTERN=imax

# Minimum ratio of free seats required to trigger an alert (0.0 to 1.0)
# 0.50 = only alert when MORE THAN 50% of the hall is free (ensures prime rows like 7-10 are open)
MIN_AVAILABILITY_RATIO=0.50

# How many days ahead to scan (180 days covers December 2026)
HORIZON_DAYS=180


# -------------------------------------------------------------------
# 2. MOBILE NOTIFICATION SECRETS (Choose one or both)
# -------------------------------------------------------------------

# Option A: ntfy.sh (Free mobile push notifications, no registration)
# 1. Install "ntfy" app from App Store or Google Play.
# 2. Subscribe to any unique secret topic name (e.g. dune-imax-2026-yourname).
# 3. Paste the topic name below:
NTFY_TOPIC=

# Option B: Telegram Bot
# 1. Create a bot via @BotFather on Telegram to get your bot token:
TELEGRAM_BOT_TOKEN=

# 2. Get your numeric chat ID via @userinfobot on Telegram:
TELEGRAM_CHAT_ID=
